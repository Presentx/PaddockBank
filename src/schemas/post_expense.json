{
  "title": "PostExpense",
  "type": "object",
  "properties": {
    "subsystem_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36
    },
    "supplier_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36
    },
    "kind": {
      "type": "string",
      "enum": [
        "SUPPLIER_PAYMENT",
        "REIMBURSEMENT"
      ]
    },
    "amount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000000000
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "invoice_number": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    }
  },
  "required": [
    "subsystem_key",
    "supplier_key",
    "kind",
    "amount",
    "description",
    "idempotency_key"
  ],
  "if": {
    "properties": {
      "kind": {
        "const": "REIMBURSEMENT"
      }
    },
    "required": [
      "kind"
    ]
  },
  "then": {
    "required": [
      "invoice_number"
    ]
  },
  "additionalProperties": false
}
