{
  "title": "PostSupplier",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "document_number": {
      "type": "string",
      "pattern": "^\\d{2}\\.\\d{3}\\.\\d{3}/\\d{4}-\\d{2}$"
    },
    "pix_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 77
    }
  },
  "required": [
    "name",
    "document_number",
    "pix_key"
  ],
  "additionalProperties": false
}
