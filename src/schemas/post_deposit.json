{
  "title": "PostDeposit",
  "type": "object",
  "properties": {
    "amount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000000000
    },
    "payer_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "payer_document": {
      "type": "string",
      "minLength": 11,
      "maxLength": 18
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    }
  },
  "required": [
    "amount",
    "payer_name",
    "payer_document",
    "idempotency_key"
  ],
  "additionalProperties": false
}
